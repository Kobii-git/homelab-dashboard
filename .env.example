NODE_ENV=production
PORT=4173
HOST=0.0.0.0

# Required - change these before first use
ADMIN_PASSWORD=change-this-admin-password
COOKIE_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# Optional read-only OPNsense integration
# OPNSENSE_ENABLED=false
# OPNSENSE_NAME=OPNsense
# OPNSENSE_BASE_URL=https://opnsense.local
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=
# OPNSENSE_TLS_VERIFY=true
# OPNSENSE_POLL_INTERVAL_SECONDS=60

# Optional AI Command Briefing. AI_API_KEY is optional for local OpenAI-compatible endpoints.
# AI_ENABLED=false
# AI_PROVIDER_NAME=AI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_TLS_VERIFY=true
# AI_BRIEFING_INTERVAL_SECONDS=21600
# AI_INCLUDE_TARGETS=false

# Optional API widget secrets. Use only the variables needed by configured widgets.
# HOME_ASSISTANT_TOKEN=
# PROXMOX_API_TOKEN=
# ADGUARD_BASIC_AUTH=username:password
# PIHOLE_PASSWORD=
# JELLYFIN_API_KEY=
# GRAFANA_TOKEN=
# SONARR_API_KEY=
# RADARR_API_KEY=
