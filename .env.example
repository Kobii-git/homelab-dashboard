NODE_ENV=production
PORT=4173
HOST=0.0.0.0

# HTTPS proxy mode: proxy serves this exact origin. The installer can instead configure private HTTP.
APP_ORIGIN=https://dashboard.home.arpa
# Determine the proxy source address as observed inside the container; do not copy broadly.
TRUST_PROXY_CIDRS=172.17.0.1/32
# Direct HTTP is opt-in, bound to one private host address. The installer configures these values.
DIRECT_HTTP_LAN=false
DASHBOARD_BIND_IP=127.0.0.1

# Required production secret. ./scripts/install-docker.sh fills this and SETUP_CODE.
# For manual setup, generate both with a cryptographic random source.
COOKIE_SECRET=
# SETUP_CODE is required only on the first boot when ADMIN_PASSWORD is omitted.
SETUP_CODE=
# ADMIN_PASSWORD is optional and skips database-backed account creation.
# ADMIN_PASSWORD=change-this-admin-password

SESSION_MAX_AGE_HOURS=168
PUBLIC_STATUS_MODE=disabled
ALLOW_INSECURE_INTEGRATIONS=false

# GitHub Container Registry image. Prefer a verified digest for production.
HOMELAB_IMAGE=ghcr.io/kobii-git/homelab-dashboard:latest

# Optional trusted private CA bundle for monitored HTTPS endpoints.
# NODE_EXTRA_CA_CERTS=/run/secrets/homelab-ca.pem

# Optional read-only OPNsense integration
# OPNSENSE_ENABLED=false
# OPNSENSE_NAME=OPNsense
# OPNSENSE_BASE_URL=https://opnsense.local
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=
# OPNSENSE_TLS_VERIFY=true
# OPNSENSE_POLL_INTERVAL_SECONDS=60

# Optional personal context. Credentials stay environment-only; data reads are read-only and OAuth refresh uses POST.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_IDS=primary
# TODOIST_API_TOKEN=
# TMDB_BEARER_TOKEN=

# Optional read-only TrueNAS SCALE 25.04+ storage integration
# TRUENAS_ENABLED=false
# TRUENAS_NAME=TrueNAS
# TRUENAS_BASE_URL=https://truenas.local
# TRUENAS_USERNAME=dashboard-reader
# TRUENAS_API_KEY=
# TRUENAS_POOL=tank
# TRUENAS_MEDIA_DATASET=tank/media
# TRUENAS_TLS_VERIFY=true
# TRUENAS_POLL_INTERVAL_SECONDS=60

# Optional AI Command Briefing. AI_API_KEY is optional for local OpenAI-compatible endpoints.
# AI_ENABLED=false
# AI_PROVIDER_NAME=AI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# AI_TLS_VERIFY=true
# AI_BRIEFING_INTERVAL_SECONDS=21600
# AI_INCLUDE_TARGETS=false

# Optional API widget secrets. Use only the variables needed by configured widgets.
# Custom secret names must also be listed here as comma-separated names.
# API_WIDGET_SECRET_ALLOWLIST=MY_CUSTOM_WIDGET_TOKEN
# HOME_ASSISTANT_TOKEN=
# PROXMOX_API_TOKEN=
# ADGUARD_BASIC_AUTH=username:password
# PIHOLE_PASSWORD=
# JELLYFIN_API_KEY=
# GRAFANA_TOKEN=
# SONARR_API_KEY=
# RADARR_API_KEY=
# PLEX_TOKEN=
