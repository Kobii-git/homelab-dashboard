{
  "name": "homelab-dashboard",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run db:push && tsx watch src/server/index.ts",
    "db:push": "sh -c 'export DATABASE_URL=\"${DATABASE_URL:-file:../data/homelab.db}\"; prisma db push'",
    "dev:client": "vite --host 0.0.0.0",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:client\"",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "db:studio": "prisma studio",
    "seed:demo": "tsx src/server/seed.ts",
    "test": "sh -c 'export NODE_ENV=test DATABASE_URL=\"file:../data/test-$(date +%s)-$$.db\" HOMELAB_VAULT_KEY=test-vault-key-for-homelab-dashboard ADMIN_PASSWORD=test-pass COOKIE_SECRET=test-cookie-secret-with-more-than-32-chars GUACD_HOST=127.0.0.1 PRISMA_SCHEMA_ENGINE_LOG_LEVEL=trace RUST_LOG=debug; prisma generate && prisma db push --skip-generate && vitest run'",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.2",
    "guacamole-common-js": "^1.5.0-a",
    "lucide-react": "^0.555.0",
    "prisma": "^6.19.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
