generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DashboardGroup {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  collapsed Boolean    @default(false)
  resources Resource[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Resource {
  id           String        @id @default(cuid())
  name         String
  kind         String
  url          String?
  description  String?
  icon         String?
  color        String?
  host         String?
  notes        String?
  favorite     Boolean       @default(false)
  monitoringMode String      @default("auto")
  manualStatus String?
  sortOrder    Int           @default(0)
  groupId      String?
  group        DashboardGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  healthChecks HealthCheck[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([groupId])
  @@index([kind])
  @@index([favorite])
}

model HealthCheck {
  id              String         @id @default(cuid())
  resourceId      String
  resource        Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  type            String
  target          String
  intervalSeconds Int            @default(60)
  timeoutMs       Int            @default(3000)
  enabled         Boolean        @default(true)
  latestStatus    String         @default("unknown")
  latestLatencyMs Int?
  latestCheckedAt DateTime?
  latestError     String?
  consecutiveFailures Int        @default(0)
  consecutiveSuccesses Int       @default(0)
  failureThreshold Int           @default(1)
  successThreshold Int           @default(1)
  lastTransitionAt DateTime?
  results         HealthResult[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([resourceId])
  @@index([enabled])
}

model HealthResult {
  id        String      @id @default(cuid())
  checkId   String
  check     HealthCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  status    String
  latencyMs Int?
  error     String?
  checkedAt DateTime    @default(now())

  @@index([checkId])
  @@index([checkedAt])
}

model HostMonitor {
  id                       String             @id @default(cuid())
  name                     String
  baseUrl                  String
  enabled                  Boolean            @default(true)
  sortOrder                Int                @default(0)
  primaryMount             String             @default("/")
  networkInterface         String?
  latestStatus             String             @default("unknown")
  latestError              String?
  latestSampledAt          DateTime?
  latestCpuPercent         Float?
  latestMemoryPercent      Float?
  latestMemoryUsedBytes    Float?
  latestMemoryTotalBytes   Float?
  latestDiskPercent        Float?
  latestDiskUsedBytes      Float?
  latestDiskTotalBytes     Float?
  latestNetworkRxBytesPerSec Float?
  latestNetworkTxBytesPerSec Float?
  latestTemperatureC       Float?
  latestContainersRunning  Int?
  latestContainersTotal    Int?
  samples                  HostMetricSample[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([enabled])
  @@index([sortOrder])
}

model HostMetricSample {
  id                 String      @id @default(cuid())
  monitorId          String
  monitor            HostMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status             String
  error              String?
  cpuPercent         Float?
  memoryPercent      Float?
  memoryUsedBytes    Float?
  memoryTotalBytes   Float?
  diskPercent        Float?
  diskUsedBytes      Float?
  diskTotalBytes     Float?
  networkRxBytesPerSec Float?
  networkTxBytesPerSec Float?
  temperatureC       Float?
  containersRunning  Int?
  containersTotal    Int?
  sampledAt          DateTime    @default(now())

  @@index([monitorId])
  @@index([sampledAt])
}

model AdminAccount {
  id           String   @id @default("admin")
  username     String   @default("admin")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
